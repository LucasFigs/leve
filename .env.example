# Copie para .env.local e preencha. O .env.local NÃO vai para o git.

# --- Usadas pelo app (também configure na Vercel) ---
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Lembretes por push — gerada por `npm run setup:push` (opcional; sem ela os avisos só chegam com o app aberto)
VITE_VAPID_PUBLIC_KEY=

# --- Só para o script `npm run setup:supabase` (NUNCA coloque na Vercel) ---
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Endereço público do app (ex.: https://leve.vercel.app)
APP_URL=http://localhost:5173
# Google Cloud → Credenciais → ID do cliente OAuth (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Só para `npm run setup:push` (o script preenche sozinho; NUNCA coloque na Vercel) ---
VAPID_PRIVATE_KEY=
PUSH_CRON_SECRET=
# Contato exigido pelo protocolo de push (opcional; padrão: APP_URL). Ex.: mailto:voce@exemplo.com
PUSH_CONTACT=
